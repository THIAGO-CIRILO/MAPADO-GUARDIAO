{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/gerar.js": {
      "maxDuration": 60
    },
    "api/atualizar-sintese.js": {
      "maxDuration": 60
    },
    "api/relatorio.js": {
      "maxDuration": 60,
      "includeFiles": "assets/fonts/**"
    }
  }
}

